VITE_BACKOFFICE_LOGIN=admin
VITE_BACKOFFICE_PASSWORD=admin

# Configuration de l'API GLPI (API REST "v1" : apirest.php)
# On passe par le proxy Vite "/glpi" defini dans vite.config.js pour eviter les CORS.
# Exemple d'appel : /glpi/apirest.php/initSession
VITE_GLPI_BASE=http://glpi.local/apirest.php/v1

# Identifiants GLPI (login / mot de passe). Servent a obtenir un session_token.
VITE_GLPI_USERNAME=glpi
VITE_GLPI_PASSWORD=glpi

# App-Token : jeton du "client API" configure dans GLPI
# (Configuration > Generale > API). Obligatoire ici car ce GLPI le demande.
VITE_GLPI_APP_TOKEN=VITE_GLPI_APP_TOKEN=UCIoUvhqmFOKIu2HNvZ0lXJ6VjEsatSPJnYUq2XD

# Adresse du backend Spring Boot (dossier "eval") qui stocke la personnalisation
# du tableau Kanban (couleurs + noms de statut en malgache) dans SQLite.
VITE_KANBAN_CONFIG_BASE=http://localhost:8080
