VITE_BACKOFFICE_LOGIN=admin
VITE_BACKOFFICE_PASSWORD=admin

# Configuration de l'API GLPI (API REST "v1" : apirest.php)
# On passe par le proxy Vite "/glpi" defini dans vite.config.js pour eviter les CORS.
# Exemple d'appel : /glpi/apirest.php/initSession
VITE_GLPI_BASE=/glpi/apirest.php

# Identifiants GLPI (login / mot de passe). Servent a obtenir un session_token.
VITE_GLPI_USERNAME=glpi
VITE_GLPI_PASSWORD=glpi

# App-Token : optionnel. A remplir seulement si un "client API" avec jeton
# d'application est configure dans GLPI (Configuration > Generale > API).
# Laisser vide si aucun n'est demande.
VITE_GLPI_APP_TOKEN=
